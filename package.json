{
  "name": "group-crossword",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:guest": "node build.mjs guest",
    "build:extension": "node build.mjs extension",
    "dev:guest": "node build.mjs guest --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "firefox": "web-ext run -s extension/dist",
    "sign": "web-ext sign -s extension/dist --channel unlisted"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "selenium-webdriver": "^4.50.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
