{
  "name": "group-crossword",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:app": "node build.mjs app",
    "build:connector": "node build.mjs connector",
    "dev:app": "node build.mjs app --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs && node e2e/race.mjs",
    "firefox": "web-ext run -s connector/dist",
    "sign": "web-ext sign -s connector/dist --channel unlisted",
    "e2e:coop": "node e2e/run.mjs",
    "e2e:race": "node e2e/race.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "selenium-webdriver": "^4.50.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
